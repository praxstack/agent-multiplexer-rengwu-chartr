     #[cfg(unix)]
+    pub(crate) fn restore_terminal_identities(
+        &mut self,
+        ids: &std::collections::HashMap<u32, crate::terminal::TerminalId>,
+    ) -> io::Result<()> {
+        let unique: std::collections::HashSet<_> = ids.values().collect();
+        if unique.len() != ids.len() {
+            return Err(io::Error::other("duplicate handoff terminal identity"));
+        }
+        let aliases = &self.state.pane_id_aliases;
+        for ws in &mut self.state.workspaces {
+            for tab in &mut ws.tabs {
+                for (pane_id, pane) in &mut tab.panes {
+                    let old_raw = aliases
+                        .iter()
+                        .find_map(|(old, new)| (new == pane_id).then_some(*old))
+                        .unwrap_or(pane_id.raw());
+                    let Some(id) = ids.get(&old_raw) else {
+                        continue;
+                    };
+                    let previous = std::mem::replace(&mut pane.attached_terminal_id, id.clone());
+                    if let Some(mut terminal) = self.state.terminals.remove(&previous) {
+                        terminal.id = id.clone();
+                        self.state.terminals.insert(id.clone(), terminal);
+                    }
+                    if let Some(runtime) = self.terminal_runtimes.remove(&previous) {
+                        self.terminal_runtimes.insert(id.clone(), runtime);
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
